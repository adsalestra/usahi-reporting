# Supabase Project Settings > API. Keep service_role secret on the server.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
# Older Supabase projects call this the service_role key, newer ones the secret key.
# Either name works; Vercel's Supabase integration sets SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
ADMIN_EMAIL=your-admin@company.com
# Google Cloud service account, viewer access to EXISTING spreadsheet only.
GOOGLE_SERVICE_ACCOUNT_EMAIL=reader@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# One or more read-only spreadsheet IDs, comma-separated. First is Ads by default.
GOOGLE_SHEETS_IDS=YOUR_REPORT_SHEET_ID
# Search Console property, read with the SAME service account above. A URL
# property ends in a slash; a domain property is written sc-domain:example.com.
# Leave unset and the dashboard simply leaves the organic search panel out.
GSC_SITE_URL=https://www.example.com/
# Optional. Searches containing any of these count as branded and are kept out
# of the non-branded figures. Comma-separated; the defaults are USA HI's own.
BRAND_TERMS=usa hi,usahi,usa home improvement,gousahi
